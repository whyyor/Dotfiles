#!/usr/bin/env bash
# focus Ghostty, then jump to the herdr pane running a singleton TUI app
# usage: hgo msg | hgo music

set -uo pipefail

# aerospace/karabiner spawn us with a bare PATH, so rebuild it
export PATH="/run/current-system/sw/bin:/opt/homebrew/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

source "$HOME/.config/scripts/herdr-lib.sh"

# target table: everything that differs between apps lives here
case "${1:-}" in
    msg | messages)
        proc_re='^gomuks'
        ws_label='Messages'
        ws_cwd="$HOME/Library/Messages"
        launch_cmd='gomuks-tui'
        ;;
    music | jf | jellyfin)
        proc_re='^jellyfin-tui$'
        ws_label='Music'
        ws_cwd="$HOME/Music"
        launch_cmd='jellyfin-tui'
        ;;
    *)
        echo "usage: ${0##*/} msg|music" >&2
        exit 2
        ;;
esac

# echo "<pane> <tab> <workspace>" for the pane whose foreground process matches $proc_re
find_target() {
    local pane tab ws
    while read -r pane tab ws; do
        if pane_matches "$pane" "$proc_re"; then
            printf '%s %s %s\n' "$pane" "$tab" "$ws"
            return 0
        fi
    done < <("$herdr_bin" pane list 2>/dev/null |
        jq -r '.result.panes[] | [.pane_id, .tab_id, .workspace_id] | @tsv')
    return 1
}

workspace_by_label() {
    "$herdr_bin" workspace list 2>/dev/null |
        jq -r --arg l "$ws_label" '.result.workspaces[]
            | select(.label | test($l)) | .workspace_id' | head -n1
}

# app is dead: reuse its workspace (or create it) and start it there
start_target() {
    local ws pane tab out

    # both create calls answer with the same root_pane shape
    ws=$(workspace_by_label)
    if [[ -z $ws ]]; then
        # a new workspace already ships with one shell, use it instead of stranding a tab
        out=$("$herdr_bin" workspace create --cwd "$ws_cwd" --label "$ws_label" --focus) || return 1
    else
        out=$("$herdr_bin" tab create --workspace "$ws" --cwd "$ws_cwd" --focus) || return 1
    fi

    pane=$(jq -r '.result.root_pane.pane_id' <<<"$out")
    tab=$(jq -r '.result.root_pane.tab_id' <<<"$out")
    ws=$(jq -r '.result.root_pane.workspace_id' <<<"$out")
    [[ -z $pane || $pane == null ]] && return 1

    pane_launch "$pane" "$proc_re" "$launch_cmd" || return 1
    printf '%s %s %s\n' "$pane" "$tab" "$ws"
}

focus_ghostty

target=$(find_target) || target=$(start_target) || exit 1
read -r pane tab ws <<<"$target"
[[ -z ${ws:-} ]] && exit 1

"$herdr_bin" workspace focus "$ws" >/dev/null
"$herdr_bin" tab focus "$tab" >/dev/null
