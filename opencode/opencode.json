{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-5-5",
  "mode": {
    "build": {
      "prompt": "You are opencode"
    }
  },
  "plugins": ["@ex-machina/opencode-anthropic-auth@next"],
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GIT_TOKEN}"
      },
      "enabled": false
    },
    "figma": {
      "type": "remote",
      "url": "https://mcp.figma.com/mcp"
    },
    "fireflies": {
      "type": "remote",
      "url": "https://api.fireflies.ai/mcp",
      "headers": {
        "Authorization": "Bearer {env:FIREFLIES_TOKEN}"
      },
      "enabled": false
    },
    "rea": {
      "type": "local",
      "command": ["npx", "-y", "rea-agents@6.4.0", "mcp"],
      "environment": {
        "GHIDRA_INSTALL_DIR": "/etc/rea/ghidra",
        "JAVA_HOME": "/etc/rea/jdk21"
      },
      "enabled": false
    },
    "servers": {
      "browse": {
        "type": "local",
        "command": [
          "/Users/whyyor/.local/bin/browse",
          "mcp"
        ],
        "cwd": "/Users/whyyor",
        "pool": true,
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  }
}
