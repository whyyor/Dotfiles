{
  "description": "Custom Multi-Rule: Alt+Semicolon Enter, Hyper Caps, and HJKL Arrows",
  "manipulators": [
    {
      "description": "Change Alt + Semicolon to Enter",
      "type": "basic",
      "from": {
        "key_code": "semicolon",
        "modifiers": { "mandatory": ["left_alt"] }
      },
      "to": [
        {
          "key_code": "return_or_enter",
          "repeat": true
        }
      ]
    },
    {
      "description": "Change Caps Lock to Hyper (Shift+Ctrl+Opt)",
      "type": "basic",
      "from": {
        "key_code": "caps_lock",
        "modifiers": { "optional": ["any"] }
      },
      "to": [
        {
          "key_code": "left_shift",
          "modifiers": ["left_control", "left_option"]
        }
      ]
    },
    {
      "description": "Left Option + H -> Left Arrow",
      "type": "basic",
      "from": {
        "key_code": "h",
        "modifiers": {
          "mandatory": ["left_option"],
          "optional": ["any"]
        }
      },
      "to": [{ "key_code": "left_arrow" }]
    },
    {
      "description": "Left Option + J -> Down Arrow",
      "type": "basic",
      "from": {
        "key_code": "j",
        "modifiers": {
          "mandatory": ["left_option"],
          "optional": ["any"]
        }
      },
      "to": [{ "key_code": "down_arrow" }]
    },
    {
      "description": "Left Option + K -> Up Arrow",
      "type": "basic",
      "from": {
        "key_code": "k",
        "modifiers": {
          "mandatory": ["left_option"],
          "optional": ["any"]
        }
      },
      "to": [{ "key_code": "up_arrow" }]
    },
    {
      "description": "Left Option + L -> Right Arrow",
      "type": "basic",
      "from": {
        "key_code": "l",
        "modifiers": {
          "mandatory": ["left_option"],
          "optional": ["any"]
        }
      },
      "to": [{ "key_code": "right_arrow" }]
    }
  ]
}
