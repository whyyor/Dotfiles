#!/usr/bin/env bash
# Bootstrap a fresh Mac up to the point where nix-darwin takes over; safe to re-run.
set -euo pipefail

DOTFILES=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
FLAKE="$DOTFILES/nix#$(whoami)"

# git + swiftc (fileclip); the installer is a GUI prompt, so re-run once it finishes
if ! xcode-select -p >/dev/null 2>&1; then
    xcode-select --install
    echo "Finish the Command Line Tools install, then re-run ./install"
    exit 1
fi

# nix-homebrew enableRosetta needs it
if ! /usr/bin/pgrep -q oahd; then
    softwareupdate --install-rosetta --agree-to-license
fi

if ! command -v nix >/dev/null 2>&1; then
    curl -L https://nixos.org/nix/install | sh -s -- --daemon --yes
    . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi

if command -v darwin-rebuild >/dev/null 2>&1; then
    sudo darwin-rebuild switch --flake "$FLAKE"
else
    # nix-darwin refuses to overwrite the stock /etc shell files on first install
    for f in /etc/zshrc /etc/bashrc; do
        if [ -f "$f" ] && [ ! -L "$f" ]; then sudo mv "$f" "$f.before-nix-darwin"; fi
    done
    sudo nix --extra-experimental-features "nix-command flakes" \
        run github:nix-darwin/nix-darwin/master#darwin-rebuild -- switch --flake "$FLAKE"
fi

echo "Done. From now on: sudo darwin-rebuild switch --flake $FLAKE"
